{
  "team1_score": 21,
  "team2_score": 10
}

### 3.31  Not logged in (expect 401)
POST {{API}}/auth/logout

###
POST {{API}}/clubs/tennis/matches/{{RES2}}/result
Content-Type: application/json

{
  "team1_score": 21,
  "team2_score": 10
}


############################################################
#  DATABASE CHECK  (run in the terminal, not in this file)
############################################################
#
#  docker exec -e PGPASSWORD=1337 database psql -h 127.0.0.1 -U club_service -d rackets_db -c "SELECT location, status, ref_id, cancelled_by, team1_score AS s1, team2_score AS s2, team1_points AS p1, team2_points AS p2, winner_id FROM club_schema.matches WHERE location LIKE 'T-%' ORDER BY id;"
#
#  What you must see at the end
#
#    location            status  ref  cancelled_by  scores   points
#    ------------------  ------  ---  ------------  -------  --------
#    T-ACCEPT               3     1        4          0-0      0/0
#    T-OWN                  3     1        1          0-0      0/0
#    T-MINE                 3    null      4          0-0      0/0
#    T-BYLEADER             3    null      1          0-0      0/0
#    T-PAST-COACH-OWN       2     4       null       21-10    10/-5
#    T-COACH-PENDING        3    null      1          0-0      0/0
#    T-PAST-EXPIRED         3    null      1          0-0      0/0
#    T-PAST-LATE            3     1        1          0-0      0/0
#    T-PAST-RESULT-1        2     1       null       21-15    10/-5
#    T-FUTURE-RESULT        1     1       null        0-0      0/0
#    T-PENDING-RESULT       0    null     null        0-0      0/0
#    T-PAST-RESULT-4        2     1       null       12-21    -5/10
#
############################################################