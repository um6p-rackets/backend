############################################################
#  LEADERBOARD ENDPOINT TESTS
#  Ensure your backend is running and the database is seeded.
############################################################

@API = http://localhost:3000/api/v1/clubs
@club_slug = tennis
@valid_target_user_id = 7
@unranked_target_user_id = 999

############################################################
#  0. SETUP: AUTHENTICATION
############################################################

### 0.1 Login as user (to get the session cookie / token)
POST http://localhost:3000/api/v1/auth/login
Content-Type: application/json

{
  "email": "user7@gmail.com",
  "password": "abdellahnsila123#002"
}


############################################################
#  1. CORE LEADERBOARD FUNCTIONALITY
############################################################

### 1.1 Fetch Standard Leaderboard (No target user)
# Expected: Returns page 1 with 10 members. target_user_row should be null.
GET {{API}}/{{club_slug}}/leaderboard?page=1&limit=10


### 1.2 Fetch Leaderboard WITH Target User (The "Sticky" Row)
# Expected: Returns page 1, AND target_user_row contains the exact rank and stats for user 7.
GET {{API}}/{{club_slug}}/leaderboard?page=1&limit=10&target_user_id={{valid_target_user_id}}


############################################################
#  2. PAGINATION EDGE CASES
############################################################

### 2.1 Pagination Check: Page 2 with small limit
# Expected: Returns ranks 4, 5, and 6. The `rank` property inside the data array MUST reflect the offset accurately.
GET {{API}}/{{club_slug}}/leaderboard?page=2&limit=3


### 2.2 Out of Bounds Pagination (Page 100) WITH Target User
# Expected: The `data` array should be empty `[]`, BUT `target_user_row` MUST still return the user's data since the window function runs independently.
GET {{API}}/{{club_slug}}/leaderboard?page=100&limit=10&target_user_id={{valid_target_user_id}}


############################################################
#  3. DOMAIN & STATE EDGE CASES
############################################################

### 3.1 Target User is Unranked (0 matches) or Doesn't Exist
# Expected: 200 OK. Paginated data returns normally, but `target_user_row` is explicitly `null` because they were filtered out by `total_matches > 0`.
GET {{API}}/{{club_slug}}/leaderboard?page=1&limit=10&target_user_id={{unranked_target_user_id}}


### 3.2 Unauthorized Club Access / Invalid Slug
# Expected: 403 Forbidden or 404 Not Found (Rejected by clubAccessService.requireRole)
GET {{API}}/fake-club-slug-999/leaderboard?page=1&limit=10