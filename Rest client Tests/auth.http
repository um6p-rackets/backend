@API = http://localhost:3000/api/v1

################################################ Auth #######################################

### 0 register a new user (expect 201)
POST {{API}}/auth/register
Content-Type: application/json

{
  "email": "testettt@gmail.com",
  "password": "abdellahnsila123#002",
  "login": "testettt",
  "first_name": "test",
  "last_name": "test",
  "gender": true,
  "department": "1337",
  "phone_number": "123456789"
}

### 1. Login (run this first, cookies are saved for the next requests)
POST {{API}}/auth/login
Content-Type: application/json

{
  "email": "coach.tennis@example.com",
  "password": "abdellahnsila123#002"
}

### 1a. Login with diffrent user account
POST {{API}}/auth/login
Content-Type: application/json

{
  "email": "abdonsila222@gmail.com",
  "password": "abdellahnsila123#002"
}

### 1b. Log out (expect 200)
POST {{API}}/auth/logout

### 1c. /me (expect 401, not logged in)
GET {{API}}/auth/me

### Update user loged with oauth google
PATCH {{API}}/auth/me
Content-Type: application/json

{
  "login": "3zwa",
  "department": "1337 Coding School",
  "phone_number": "+212600000000",
  "gender": true
}

### 1f. Update Profile - Single Field (expect 200, requires valid cookies)
PATCH {{API}}/auth/me
Content-Type: application/json

{
  "avatar": "https://example.com/new-avatar.png"
}

### /users/login-available?login=player36 exist
GET {{API}}/auth/users/login-available?login=player36


### /users/login-available?login=atomic dont exist
GET {{API}}/auth/users/login-available?login=atomic


### 1d. Refresh token (expect 200)
POST {{API}}/auth/refresh


