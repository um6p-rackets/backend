@API = http://localhost:3000/api/v1

################################################ Auth #######################################

### 0 register a new user (expect 201)
POST {{API}}/auth/register
Content-Type: application/json

{
  "email": "abdonsila2004@gmail.com",
  "password": "abdellahnsila123#002",
  "login": "abdo",
  "first_name": "Abdellah",
  "last_name": "Nsila",
  "gender": true,
  "department": "1337",
  "phone_number": "123456789"
}

### 1. Login (run this first, cookies are saved for the next requests)
POST {{API}}/auth/login
Content-Type: application/json

{
  "email": "abdonsila2004@gmail.com",
  "password": "NewSecurePassword123!"
}

### 1a. Login with diffrent user account
POST {{API}}/auth/login
Content-Type: application/json

{
  "email": "abdonsila222@gmail.com",
  "password": "abdellahnsila123#002"
}

### 2. Request password reset
POST {{API}}/auth/forget-password
Content-Type: application/json

{
  "email": "abdonsila2004@gmail.com"
}

