@API = http://localhost:3000/api/v1
# @API = https://localhost/api/v1


################################################ Auth #######################################

### 0 register a new user (expect 201)
POST {{API}}/auth/register
Content-Type: application/json

{
  "email": "abdonsila2004@gmail.com",
  "password": "abdellahnsila123#002",
  "login": "abdo",
  "first_name": "Abdellah",
  "last_name": "Nsila",
  "gender": true,
  "department": "1337",
  "phone_number": "123456789"
}

### 1a. Login with original password (expect 200)
POST {{API}}/auth/login
Content-Type: application/json

{
  "email": "abdonsila2004@gmail.com",
  "password": "abdellahnsila123#002"
}

### 1. Login with new password (for next requests)
POST {{API}}/auth/login
Content-Type: application/json

{
  "email": "abdonsila2004@gmail.com",
  "password": "NewSecurePassword123!"
}


### 1b. Log out (expect 200)
POST {{API}}/auth/logout


### 2. Request password reset
POST {{API}}/auth/forget-password
Content-Type: application/json

{
  "email": "abdonsila2004@gmail.com"
}

### 3. Reset password
POST {{API}}/auth/reset-password
Content-Type: application/json

{
  "token": "4q-LDlDxXCFGJoMUMoUwW9wOLWLaaP0JozHHatNG-rk",
  "password": "NewSecurePassword123!"
}