############################################################
#  DATABASE CHECK  (run in the terminal, not in this file)
############################################################
#
#  docker exec -e PGPASSWORD=1337 database psql -h 127.0.0.1 -U club_service -d rackets_db -c "SELECT id, mode, status, ref_id, location, scheduled_at, team1_id, team2_id FROM club_schema.matches ORDER BY id DESC LIMIT 10;"
#
#  What to see for every match created above:
#    status = 0 (pending)       ref_id = NULL (no referee yet)
#    location trimmed (A4)      location NULL (A3, A5)
#    A1: team1 = member 4 alone, team2 = member 5 alone
#    A2: team1 = member 4 + 5,   team2 = member 6 + 7
#
#  The names "singles" and "doubles" (# @name) are saved:
#    {{singles.response.body.pending_match_id}}
#    {{doubles.response.body.pending_match_id}}
#  Use them in part 2 (accept) without copying ids by hand.