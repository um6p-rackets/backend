@API = http://localhost:3000/api/v1

### 1. Login as the tennis coach
POST {{API}}/auth/login
Content-Type: application/json

{
  "email": "coach.tennis@example.com",
  "password": "abdellahnsila123#002"
}

### 2. Default list (expect 200, page 1, limit 20, total 2, 2 items)
GET {{API}}/clubs/tennis/announcements

### 3. Page 1 with limit 1 (expect 1 item, the NEWEST: "Sessions start this Monday at 17:00.")
GET {{API}}/clubs/tennis/announcements?page=1&limit=1

### 4. Page 2 with limit 1 (expect 1 item, the older: "Welcome to the new season!")
GET {{API}}/clubs/tennis/announcements?page=2&limit=1

### 5. Page after the last one (expect 200, data is [], total still 2)
GET {{API}}/clubs/tennis/announcements?page=3&limit=1

### 6. Page 0 (expect 400)
GET {{API}}/clubs/tennis/announcements?page=0

### 7. Limit above 50 (expect 400)
GET {{API}}/clubs/tennis/announcements?limit=51

### 8. Limit not a number (expect 400)
GET {{API}}/clubs/tennis/announcements?limit=abc

### 9. Club that does not exist (expect 404)
GET {{API}}/clubs/not-a-club/announcements

### 10. Login as the plain member testettt
POST {{API}}/auth/login
Content-Type: application/json

{
  "email": "user7@gmail.com",
  "password": "abdellahnsila123#002"
}

### 11. A plain member can read (expect 200, same data)
GET {{API}}/clubs/tennis/announcements

### 12. Login as the PADEL coach (not a member of tennis)
POST {{API}}/auth/login
Content-Type: application/json

{
  "email": "coach.padel@example.com",
  "password": "abdellahnsila123#002"
}

### 13. Not a member of this club (expect 403)
GET {{API}}/clubs/tennis/announcements

### 14. Padel coach reads their own club (expect 200, padel announcements, not tennis)
GET {{API}}/clubs/padel/announcements

### 14.1. 
GET {{API}}/clubs/badminton/announcements

### 15. Logout
POST {{API}}/auth/logout

### 16. Not logged in (expect 401)
GET {{API}}/clubs/tennis/announcements


################################ Test for creating and deleting announcements ###################################

@A = 13
@B = 17
@MEMBER_ID = 4

### 1. Login as the tennis coach
POST {{API}}/auth/login
Content-Type: application/json

{
  "email": "coach.tennis@example.com",
  "password": "abdellahnsila123#002"
}

### 2. Create announcement A (expect success, copy its "id" into @A above)
POST {{API}}/clubs/tennis/announcements
Content-Type: application/json

{
  "description": "Announcement A from the coach"
}

### 3. The list must show A first, with announcer coach_tennis
GET {{API}}/clubs/tennis/announcements

### 4. Spaces only (expect 400)
POST {{API}}/clubs/tennis/announcements
Content-Type: application/json

{
  "description": "     "
}

### 5. Empty description (expect 400)
POST {{API}}/clubs/tennis/announcements
Content-Type: application/json

{
  "description": ""
}

### 6. Empty body (expect 400)
POST {{API}}/clubs/tennis/announcements
Content-Type: application/json

{}

### 7. Extra property (expect 400)
POST {{API}}/clubs/tennis/announcements
Content-Type: application/json

{
  "description": "x",
  "club_id": 2
}

### 8. Club that does not exist (expect 404)
POST {{API}}/clubs/not-a-club/announcements
Content-Type: application/json

{
  "description": "x"
}

### 9. Login as the plain member testettt
POST {{API}}/auth/login
Content-Type: application/json

{
  "email": "user7@gmail.com",
  "password": "abdellahnsila123#002"
}

### 10. Plain member creates (expect 403)
POST {{API}}/clubs/tennis/announcements
Content-Type: application/json

{
  "description": "x"
}

### 11. Plain member deletes A (expect 403)
DELETE {{API}}/clubs/tennis/announcements/{{A}}

### 12. Login as the coach, then promote testettt to leader
POST {{API}}/auth/login
Content-Type: application/json

{
  "email": "coach.tennis@example.com",
  "password": "abdellahnsila123#002"
}

###
PATCH {{API}}/clubs/tennis/members/{{MEMBER_ID}}/role
Content-Type: application/json

{
  "role": 1
}

### 13. Login as testettt (now leader)
POST {{API}}/auth/login
Content-Type: application/json

{
  "email": "user7@gmail.com",
  "password": "abdellahnsila123#002"
}

### 14. Leader creates announcement B (expect success, copy its "id" into @B above)
POST {{API}}/clubs/tennis/announcements
Content-Type: application/json

{
  "description": "Announcement B from the leader"
}

### 15. Login as the PADEL coach (not a member of tennis)
POST {{API}}/auth/login
Content-Type: application/json

{
  "email": "coach.padel@example.com",
  "password": "abdellahnsila123#002"
}

### 16. Padel coach creates in tennis (expect 403)
POST {{API}}/clubs/tennis/announcements
Content-Type: application/json

{
  "description": "x"
}

### 17. Padel coach deletes A in tennis (expect 403)
DELETE {{API}}/clubs/tennis/announcements/{{A}}

### 18. Padel coach deletes A through their OWN club (expect 404, A belongs to tennis)
DELETE {{API}}/clubs/padel/announcements/{{A}}

### 19. Login as testettt (leader)
POST {{API}}/auth/login
Content-Type: application/json

{
  "email": "testettt@gmail.com",
  "password": "abdellahnsila123#002"
}

### 20. Leader deletes the coach's announcement A (expect success)
DELETE {{API}}/clubs/tennis/announcements/{{A}}

### 21. The list must not include A anymore, and B must still be there
GET {{API}}/clubs/tennis/announcements

### 22. Login as the coach
POST {{API}}/auth/login
Content-Type: application/json

{
  "email": "coach.tennis@example.com",
  "password": "abdellahnsila123#002"
}

### 23. Coach deletes the leader's announcement B (expect success)
DELETE {{API}}/clubs/tennis/announcements/{{B}}

### 24. Delete B again (expect 404)
DELETE {{API}}/clubs/tennis/announcements/{{B}}

### 25. Id that does not exist (expect 404)
