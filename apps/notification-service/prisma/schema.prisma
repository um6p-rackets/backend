generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// The event itself, stored ONCE no matter how many users receive it.
model Notification {
  id BigInt @id @default(autoincrement())

  /// Who triggered it. Values come from the contracts enum.
  /// 1 = SYSTEM (automatic, e.g. reminder), 2 = USER (a person did something)
  senderType Int @map("sender_type")

  /// Id of the user who triggered it (lives in auth-service, so no FK).
  /// Example: 12 = the player who asked to join. null when senderType = SYSTEM.
  senderId BigInt? @map("sender_id")

  /// What happened. Value from the NotifCategory enum in contracts.
  /// Example: 1 = JOIN_REQUESTED, 2 = JOIN_ACCEPTED, 4 = MATCH_SCHEDULED.
  /// The front-end builds the message text from this + senderId.
  category Int

  /// Which club it belongs to (id from club-service, no FK).
  /// Used for the link to the club page and for filtering by club.
  /// Example: 5. null only for notifications not tied to a club.
  clubId BigInt? @map("club_id")

  /// The specific item to open. What it means depends on `category`:
  /// JOIN_REQUESTED -> request id (77), MATCH_SCHEDULED -> match id (31),
  /// TOURNAMENT_CREATED -> tournament id (4). null when the club page is enough
  /// (e.g. JOIN_ACCEPTED). It is just a pointer: no FK, it says nothing
  /// about read/handled state.
  entityId BigInt? @map("entity_id")

  /// Protects against duplicates when RabbitMQ redelivers an event.
  /// Format: "<category>:<what>:<who>", e.g. "join_requested:77" or
  /// "match_reminder:31:1h". null for notifications that may legitimately repeat.
  dedupeKey String? @unique @map("dedupe_key")

  /// When it was created. Set automatically, never sent by the client.
  sentAt DateTime @default(now()) @map("sent_at") @db.Timestamptz

  receivers NotificationReceiver[]

  @@map("notifications")
}

/// One row per user who receives a notification (holds the per-user state).
model NotificationReceiver {
  id BigInt @id @default(autoincrement())

  /// Which notification. Deleting the notification removes its receivers.
  notificationId BigInt @map("notification_id")

  /// The user who gets it (id from auth-service, no FK).
  /// Example: 3 = the coach. ALWAYS filter by the id from the JWT when reading.
  receiverUserId BigInt @map("receiver_user_id")

  /// false when created, true once the user opened it. Drives the unread badge.
  isRead Boolean @default(false) @map("is_read")

  /// When the user read it. null while unread.
  readAt DateTime? @map("read_at") @db.Timestamptz

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  /// One row per user per notification.
  @@unique([notificationId, receiverUserId])
  /// Inbox list, newest first (use `where id < cursor`, not OFFSET).
  @@index([receiverUserId, id(sort: Desc)])
  @@map("notification_receivers")
}