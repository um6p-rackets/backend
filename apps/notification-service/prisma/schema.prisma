generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}


// WHO caused the notification?
enum SenderType {
  SYSTEM // for email notifications, the system will be the sender
  USER // if a user caused the notification, the user will be the sender
  // CLUB // this for annoncement notifications, the club service will be the sender
}

// WHAT area of the application does it belong to?
// Used for broad filtering in the frontend.
enum NotificationCategory {
  CLUB
  USER
  // MATCH
}

// WHAT exactly happened?
// Used to determine the message and notification behavior.
enum NotificationType {
  JOIN_REQUESTED
  JOIN_ACCEPTED
  JOIN_REJECTED
  CLUB_ANNOUNCEMENT
  // MATCH_SCHEDULED
  // MATCH_RESULT
}

model Notification {
  // Internal database ID.
  // Example: 501
  id BigInt @id @default(autoincrement())

  // Unique ID generated by the event producer.
  // Reuse the same ID when retrying the same event.
  // Example: "club-event-uuid-123"
  event_id String @unique @map("event_id")

  // Who caused this notification?
  // Example: USER for a club join request, SYSTEM for an announcement.
  sender_type SenderType @map("sender_type")

  // ID of the user who caused the event.
  // Null when the system itself is the sender.
  // Example: 42, or null for a system-generated event.
  sender_id BigInt? @map("sender_id")

  // Broad group for filtering notifications.
  // Example: CLUB
  category NotificationCategory

  // Exact event that occurred.
  // Example: JOIN_REQUESTED
  type NotificationType

  // Related club ID, owned by the club service.
  // No foreign key because another microservice owns this entity.
  // Example: 9001, or null if not related to a club.
  club_id BigInt? @map("club_id")

  // Optional business-level deduplication key.
  // Prevents duplicate business actions when the same action
  // arrives with different event IDs, if the producer supplies
  // a consistent key.
  // Example: "join-request:club-9001:user-42"
  // Null when no business-level deduplication is required.
  // dedupe_key String? @unique @map("dedupe_key")

  // When the notification event was recorded.
  // Example: 2026-10-18T12:00:00Z
  sent_at DateTime @default(now()) @map("sent_at") @db.Timestamptz(6)

  // All user-specific delivery/read records for this notification.
  receivers NotificationReceiver[]

  @@index([category, id(sort: Desc)])
  @@index([club_id, id(sort: Desc)])
  @@map("notifications")
}

model NotificationReceiver {
  // Internal ID for this recipient record.
  // Example: 10001
  id BigInt @id @default(autoincrement())

  // Foreign key to notifications.id.
  // Prisma fills this automatically when creating receivers
  // through Notification.receivers.create.
  // Example: 501
  notification_id BigInt @map("notification_id")

  // User who receives this notification.
  // User ID is owned by another service; no user-table foreign key.
  // Example: 42
  receiver_user_id BigInt @map("receiver_user_id")

  // Whether THIS recipient has read the notification.
  // Defaults to false for every recipient.
  // Example: false
  is_read Boolean @default(false) @map("is_read")

  // When THIS recipient read the notification.
  // Null until the recipient reads it.
  // Example: 2026-10-18T12:05:00Z, or null
  read_at DateTime? @map("read_at") @db.Timestamptz(6)

  // Connects this recipient record to its notification.
  // Deleting a notification also deletes its receiver records.
  notification Notification @relation(fields: [notification_id], references: [id], onDelete: Cascade)

  // A user must not receive the same notification twice.
  @@unique([notification_id, receiver_user_id])
  // Efficient inbox pagination for one user, newest first.
  @@index([receiver_user_id, id(sort: Desc)])
  // Efficient lookup of unread notifications for a user.
  @@index([receiver_user_id, is_read])
  @@map("notification_receivers")
}
