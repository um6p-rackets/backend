generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Notification {
  id BigInt @id @default(autoincrement())

  // Stable ID generated by the producer for one published event.
  // Reuse it when retrying or republishing that same event.
  eventId String @unique @map("event_id")

  // 1 = SYSTEM, 2 = USER
  senderType Int    @map("sender_type")
  senderId   BigInt? @map("sender_id")

  // Value from the shared NotificationCategory enum.
  // example: 1 = CLUB, 2 = ENTITY, 3 = USER
  // meaning: so the front end can filter notifications by category.? 
  // and the backend can route notifications to the right service for processing.
  // meaning: join_request , join_accepted, join_rejected, club_announcement
  category Int

  // IDs owned by other services; no foreign keys.
  clubId   BigInt? @map("club_id")

  // we dont actualy need this only if we want to click on the notification 
  // to retrive the entity details 
  // entityId BigInt? @map("entity_id")

  // Business-level deduplication across different event IDs.
  // Null when no business-level deduplication rule applies.
  dedupeKey String? @unique @map("dedupe_key")

  sentAt DateTime @default(now()) @map("sent_at") @db.Timestamptz

  receivers NotificationReceiver[]

  @@map("notifications")
}

model NotificationReceiver {
  id BigInt @id @default(autoincrement())

  notificationId BigInt @map("notification_id")
  receiverUserId BigInt @map("receiver_user_id")

  isRead Boolean   @default(false) @map("is_read")
  readAt DateTime? @map("read_at") @db.Timestamptz

  // explaine d in Notification model, but repeated here for clarity.
  // This is a foreign key to the Notification table, with cascade delete.
  // When a notification is deleted, all its receivers are also deleted.
  notification Notification @relation(fields: [notificationId],references: [id],onDelete: Cascade)

  // One receiver row per user per notification.
  @@unique([notificationId, receiverUserId])

  // Efficient inbox pagination, newest first.
  @@index([receiverUserId, id(sort: Desc)])

  @@map("notification_receivers")
}